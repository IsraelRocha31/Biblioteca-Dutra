# ============================================================
# VERCEL <-> SUPABASE (CONTRATO VERSIONADO)
# ============================================================
# Estas 12 chaves documentam a integração. Na Vercel, os valores reais
# injetados pela integração têm prioridade sobre os valores deste arquivo.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# ============================================================
# IDENTIDADE E ROTAS DA APLICAÇÃO
# ============================================================
APP_NAME=Biblioteca
APP_SCHOOL_NAME=EE Alfredo Dutra
APP_API_NAME=Biblioteca Dutra API
APP_API_VERSION=3.0.0
APP_API_BASE_PATH=/api
APP_SERVER_LABEL=Vercel
APP_DATABASE_LABEL=Supabase PostgreSQL
VITE_HTML_TITLE=Biblioteca - EE Alfredo Dutra

# ============================================================
# ADMINISTRADOR E AUTENTICAÇÃO
# ============================================================
SUPER_ADMIN_NAME=Super Administrador
SUPER_ADMIN_EMAIL=admin@alfredodutra.edu.br
SUPER_ADMIN_PASSWORD=admin123
JWT_SECRET=biblioteca-dutra-test-jwt-secret-2026
JWT_EXPIRES_IN=24h
BCRYPT_COST=12
ADMIN_MIN_PASSWORD_LENGTH=8
VITE_AUTH_TOKEN_STORAGE_KEY=biblioteca-dutra-token

# ============================================================
# FRONTEND / DESENVOLVIMENTO LOCAL
# ============================================================
DEV_PROTOCOL=http
DEV_HOST=localhost
FRONTEND_PORT=5173
UI_SEARCH_DEBOUNCE_MS=300

# ============================================================
# BACKEND / HTTP
# ============================================================
PORT=3000
CORS_ORIGIN=http://localhost:5173
HTTP_JSON_BODY_LIMIT=1mb
HTTP_URLENCODED_BODY_LIMIT=1mb

# ============================================================
# POSTGRESQL EM RUNTIME (SERVIDOR VERCEL)
# ============================================================
DB_POOL_MAX=1
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL_USE_LIBPQ_COMPAT=true

# ============================================================
# LIVROS / UPLOAD / PAGINAÇÃO
# ============================================================
BOOKS_DEFAULT_PAGE_SIZE=20
BOOKS_MAX_PAGE_SIZE=100
BOOK_COVER_MAX_SIZE_MB=4
BOOK_COVER_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
BOOK_COVER_CACHE_CONTROL=public, max-age=86400, immutable
